{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "client/pages/print/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/pages/print/(.*)",
      "destination": "/client/pages/print/$1"
    },
    {
      "source": "/pages/(.*)",
      "destination": "/client/pages/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/client/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/client/js/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/client/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/client/$1"
    }
  ]
}
