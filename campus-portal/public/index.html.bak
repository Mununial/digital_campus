<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>BEC Digital Campus - Student Portal</title>
  <link rel="icon" type="image/png" href="/assets/bec circle logo.png">
  <link rel="stylesheet" href="/shell/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

  <!-- Master Top Banner -->
  <header class="portal-top-banner">
    <div class="banner-brand">
      <img src="/assets/bec logo.jpeg" alt="BEC Logo" class="college-logo">
      <div class="banner-title">
        <h1>DIGITAL CAMPUS STUDENT PORTAL</h1>
        <p>One Login • All Services • A Smarter Campus Life</p>
      </div>
    </div>
    <div style="display: flex; align-items: center; gap: 16px;">
      <div class="banner-quote">
        "Your Campus. In Your Hands."
      </div>
      <a href="/admin" style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); color: #fff; padding: 6px 14px; border-radius: 8px; text-decoration: none; font-size: 0.8rem; font-weight: 700; display: flex; align-items: center; gap: 6px; transition: background 0.2s;">
        <i class="fa-solid fa-shield-halved"></i> Admin Portal
      </a>
    </div>
  </header>

  <!-- Mobile Stage Viewport -->
  <main class="portal-stage">
    <div class="mobile-phone-frame">
      
      <!-- Notch Element -->
      <div class="phone-notch">
        <div class="phone-camera"></div>
        <div class="phone-speaker"></div>
      </div>

      <!-- Scrollable Phone Container -->
      <div class="screen-scroll-container">

        <!-- ========================================== -->
        <!-- SCREEN 1: LOGIN & AUTHENTICATION           -->
        <!-- ========================================== -->
        <section id="screen-login" class="portal-screen">
          <div style="position: relative; width: 100%; height: 190px; overflow: hidden; background: #1e3a8a;">
            <img src="/assets/bec college building photo.jpeg" alt="BEC Campus" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.7;">
            <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,23,42,0.4) 0%, rgba(15,23,42,0.85) 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 16px; text-align: center;">
              <img src="/assets/bec circle logo.png" alt="BEC Logo" style="width: 58px; height: 58px; border-radius: 50%; background: #fff; padding: 3px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); margin-bottom: 6px;">
              <h2 style="color: #fff; font-size: 1.15rem; font-weight: 800; letter-spacing: 0.05em;">BEC Digital Campus</h2>
              <p style="color: #93c5fd; font-size: 0.72rem; font-weight: 500;">One Campus. One Platform. A Better Tomorrow.</p>
            </div>
          </div>

          <div style="padding: 20px 20px 30px;">
            <!-- Role Toggle -->
            <div style="display: flex; background: #e2e8f0; border-radius: 12px; padding: 4px; margin-bottom: 20px;">
              <button type="button" id="toggle-student" onclick="setLoginType('student')" style="flex: 1; padding: 9px; border-radius: 9px; border: none; font-size: 0.8rem; font-weight: 700; cursor: pointer; background: #2563eb; color: #fff; transition: all 0.2s;">
                Student
              </button>
              <button type="button" id="toggle-faculty" onclick="setLoginType('faculty')" style="flex: 1; padding: 9px; border-radius: 9px; border: none; font-size: 0.8rem; font-weight: 700; cursor: pointer; background: transparent; color: #475569; transition: all 0.2s;">
                Faculty/Admin
              </button>
            </div>

            <!-- Login Form -->
            <form id="portal-login-form" onsubmit="handlePortalLogin(event)">
              <div style="margin-bottom: 14px;">
                <label id="login-identifier-label" style="display: block; font-size: 0.75rem; font-weight: 700; color: #334155; margin-bottom: 6px;">College Roll Number</label>
                <div style="position: relative;">
                  <i class="fa-regular fa-user" style="position: absolute; left: 14px; top: 13px; color: #94a3b8; font-size: 0.95rem;"></i>
                  <input type="text" id="login-identifier" value="24CSE018" required placeholder="e.g. 24CSE018" style="width: 100%; padding: 11px 14px 11px 40px; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 0.85rem; font-weight: 600; color: #0f172a; outline: none;">
                </div>
              </div>

              <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.75rem; font-weight: 700; color: #334155; margin-bottom: 6px;">Password</label>
                <div style="position: relative;">
                  <i class="fa-solid fa-lock" style="position: absolute; left: 14px; top: 13px; color: #94a3b8; font-size: 0.95rem;"></i>
                  <input type="password" id="login-password" value="demo123" required placeholder="••••••••" style="width: 100%; padding: 11px 14px 11px 40px; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 0.85rem; font-weight: 600; color: #0f172a; outline: none;">
                </div>
              </div>

              <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.72rem; margin-bottom: 22px;">
                <label style="display: flex; align-items: center; gap: 6px; color: #475569; cursor: pointer; font-weight: 600;">
                  <input type="checkbox" checked style="accent-color: #2563eb;"> Remember me
                </label>
                <a href="javascript:void(0)" onclick="alert('Please contact academic administrator cell for password reset.')" style="color: #2563eb; text-decoration: none; font-weight: 700;">Forgot Password?</a>
              </div>

              <button type="submit" id="btn-portal-login" style="width: 100%; padding: 12px; border-radius: 12px; background: #2563eb; color: #fff; font-size: 0.95rem; font-weight: 800; border: none; cursor: pointer; box-shadow: 0 4px 12px rgba(37,99,235,0.35); transition: background 0.2s;">
                Login
              </button>
            </form>

            <div style="text-align: center; margin-top: 24px;">
              <p style="font-size: 0.75rem; color: #64748b; font-weight: 600;">New Student? <a href="/reporting/pages/submission.html" style="color: #2563eb; font-weight: 800; text-decoration: none;">Reporting & Admission Portal</a></p>
              <div style="margin-top: 28px; padding-top: 16px; border-top: 1px solid #e2e8f0;">
                <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">Together for a Smarter Campus</p>
                <p style="font-size: 0.72rem; color: #1e3a8a; font-weight: 800;">Bhubaneswar Engineering College</p>
              </div>
            </div>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- SCREEN 2: STUDENT DASHBOARD                -->
        <!-- ========================================== -->
        <section id="screen-dashboard" class="portal-screen active">
          <!-- Top Greeting Bar -->
          <div style="padding: 14px 18px 10px; display: flex; align-items: center; justify-content: space-between; background: #fff;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <img src="/assets/bec circle logo.png" alt="Student Avatar" style="width: 44px; height: 44px; border-radius: 50%; border: 2px solid #2563eb; object-fit: cover;">
              <div>
                <p style="font-size: 0.7rem; color: #64748b; font-weight: 600;">Good Morning,</p>
                <h3 style="font-size: 0.95rem; font-weight: 800; color: #0f172a;" id="dash-student-name">Rohan Kumar</h3>
                <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;" id="dash-student-sub">B.Tech CSE • 4th Semester</p>
              </div>
            </div>
            <div style="position: relative; cursor: pointer;" onclick="navigateToScreen('screen-activity')">
              <div style="width: 36px; height: 36px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #334155;">
                <i class="fa-regular fa-bell"></i>
              </div>
              <span style="position: absolute; top: -2px; right: -2px; width: 14px; height: 14px; border-radius: 50%; background: #ef4444; color: #fff; font-size: 0.55rem; font-weight: 800; display: flex; align-items: center; justify-content: center;">1</span>
            </div>
          </div>

          <!-- 4 Stat Cards (2x2 Grid) -->
          <div class="stats-grid-2x2">
            <div class="stat-box hostel" onclick="navigateToScreen('screen-hostel')" style="cursor: pointer;">
              <div class="stat-box-icon"><i class="fa-solid fa-hotel"></i></div>
              <div class="stat-box-title">Hostel</div>
              <div class="stat-box-value">Room 204</div>
              <div class="stat-box-sub">Block A</div>
            </div>
            <div class="stat-box attendance" onclick="navigateToScreen('screen-attendance')" style="cursor: pointer;">
              <div class="stat-box-icon"><i class="fa-solid fa-chart-pie"></i></div>
              <div class="stat-box-title">Attendance</div>
              <div class="stat-box-value" style="color: #059669;">86.4%</div>
              <div class="stat-box-sub">Overall</div>
            </div>
            <div class="stat-box library" onclick="navigateToScreen('screen-library')" style="cursor: pointer;">
              <div class="stat-box-icon"><i class="fa-solid fa-book"></i></div>
              <div class="stat-box-title">Library</div>
              <div class="stat-box-value">2 books</div>
              <div class="stat-box-sub">Due in 5 days</div>
            </div>
            <div class="stat-box fees" onclick="navigateToScreen('screen-fees')" style="cursor: pointer;">
              <div class="stat-box-icon"><i class="fa-solid fa-receipt"></i></div>
              <div class="stat-box-title">Fees</div>
              <div class="stat-box-value" style="color: #dc2626;">₹4,500</div>
              <div class="stat-box-sub">Pending</div>
            </div>
          </div>

          <!-- Quick Actions Grid (8 Colorful Icons) -->
          <div style="padding: 0 16px 8px;">
            <h4 style="font-size: 0.8rem; font-weight: 800; color: #0f172a; margin-bottom: 10px;">Quick Actions</h4>
          </div>
          <div class="actions-grid-4x2">
            <button class="action-btn-item" onclick="openReportModal()">
              <div class="action-icon-circle" style="background: #ffe4e6; color: #e11d48;"><i class="fa-solid fa-triangle-exclamation"></i></div>
              <span class="action-label">Report Problem</span>
            </button>
            <button class="action-btn-item" onclick="navigateToScreen('screen-hostel')">
              <div class="action-icon-circle" style="background: #ffedd5; color: #ea580c;"><i class="fa-regular fa-calendar-minus"></i></div>
              <span class="action-label">Apply Leave</span>
            </button>
            <button class="action-btn-item" onclick="navigateToScreen('screen-hostel')">
              <div class="action-icon-circle" style="background: #e0f2fe; color: #0284c7;"><i class="fa-solid fa-id-badge"></i></div>
              <span class="action-label">Gate Pass</span>
            </button>
            <button class="action-btn-item" onclick="navigateToScreen('screen-mess')">
              <div class="action-icon-circle" style="background: #ccfbf1; color: #0d9488;"><i class="fa-solid fa-utensils"></i></div>
              <span class="action-label">Mess Menu</span>
            </button>
            <button class="action-btn-item" onclick="navigateToScreen('screen-library')">
              <div class="action-icon-circle" style="background: #ede9fe; color: #7c3aed;"><i class="fa-solid fa-book-bookmark"></i></div>
              <span class="action-label">Library</span>
            </button>
            <button class="action-btn-item" onclick="navigateToScreen('screen-fees')">
              <div class="action-icon-circle" style="background: #dbeafe; color: #2563eb;"><i class="fa-solid fa-credit-card"></i></div>
              <span class="action-label">Pay Fees</span>
            </button>
            <button class="action-btn-item" onclick="navigateToScreen('screen-notices')">
              <div class="action-icon-circle" style="background: #cffafe; color: #0891b2;"><i class="fa-regular fa-bell"></i></div>
              <span class="action-label">Notices</span>
            </button>
            <button class="action-btn-item" onclick="navigateToScreen('screen-services')">
              <div class="action-icon-circle" style="background: #f1f5f9; color: #475569;"><i class="fa-solid fa-ellipsis"></i></div>
              <span class="action-label">More</span>
            </button>
          </div>

          <!-- Recent Activity List -->
          <div style="padding: 12px 16px 0;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
              <h4 style="font-size: 0.8rem; font-weight: 800; color: #0f172a;">Recent Activity</h4>
              <a href="javascript:void(0)" onclick="navigateToScreen('screen-activity')" style="font-size: 0.72rem; color: #2563eb; font-weight: 700; text-decoration: none;">View All</a>
            </div>
            
            <div class="card-bec" style="padding: 12px 14px;">
              <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f1f5f9;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <i class="fa-solid fa-fan" style="color: #f59e0b; width: 18px;"></i>
                  <div>
                    <p style="font-size: 0.78rem; font-weight: 700; color: #0f172a;">Fan complaint</p>
                  </div>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span class="badge-status badge-in-progress">In Progress</span>
                  <span style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">12 Sep</span>
                </div>
              </div>

              <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f1f5f9;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <i class="fa-solid fa-book" style="color: #7c3aed; width: 18px;"></i>
                  <div>
                    <p style="font-size: 0.78rem; font-weight: 700; color: #0f172a;">Book issued - DBMS</p>
                  </div>
                </div>
                <span style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">10 Sep</span>
              </div>

              <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 0;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <i class="fa-solid fa-circle-check" style="color: #10b981; width: 18px;"></i>
                  <div>
                    <p style="font-size: 0.78rem; font-weight: 700; color: #0f172a;">Gate pass approved</p>
                  </div>
                </div>
                <span style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">8 Sep</span>
              </div>
            </div>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- SCREEN 3: PROFILE & PERSONAL DETAILS       -->
        <!-- ========================================== -->
        <section id="screen-profile" class="portal-screen">
          <div class="screen-header">
            <button class="screen-header-back" onclick="goBackScreen()"><i class="fa-solid fa-chevron-left"></i></button>
            <span class="screen-header-title">My Profile</span>
            <button class="screen-header-action" onclick="alert('Profile edit mode enabled.')"><i class="fa-regular fa-pen-to-square"></i></button>
          </div>

          <div style="padding: 16px;">
            <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 16px;">
              <img src="/assets/bec circle logo.png" alt="Rohan Kumar" style="width: 64px; height: 64px; border-radius: 50%; border: 3px solid #2563eb;">
              <div>
                <h3 style="font-size: 1.05rem; font-weight: 800; color: #0f172a;">Rohan Kumar</h3>
                <p style="font-size: 0.72rem; color: #475569; font-weight: 600;">Roll No: 24CSE018</p>
                <p style="font-size: 0.72rem; color: #64748b;">B.Tech CSE (Data Science) • 4th Semester</p>
                <span class="badge-status badge-approved" style="margin-top: 4px;">Active Student</span>
              </div>
            </div>

            <!-- Profile Tabs -->
            <div style="display: flex; background: #e2e8f0; border-radius: 10px; padding: 3px; margin-bottom: 16px;">
              <button style="flex: 1; padding: 7px; border-radius: 8px; border: none; font-size: 0.75rem; font-weight: 700; background: #2563eb; color: #fff;">Personal</button>
              <button style="flex: 1; padding: 7px; border-radius: 8px; border: none; font-size: 0.75rem; font-weight: 700; background: transparent; color: #475569;">Academic</button>
              <button style="flex: 1; padding: 7px; border-radius: 8px; border: none; font-size: 0.75rem; font-weight: 700; background: transparent; color: #475569;">Documents</button>
            </div>

            <div class="card-bec" style="padding: 6px 14px;">
              <div style="padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
                <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Full Name</p>
                <p style="font-size: 0.85rem; font-weight: 700; color: #0f172a;">Rohan Kumar</p>
              </div>
              <div style="padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
                <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Email</p>
                <p style="font-size: 0.85rem; font-weight: 700; color: #0f172a;">rohan24@bec.ac.in</p>
              </div>
              <div style="padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
                <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Phone</p>
                <p style="font-size: 0.85rem; font-weight: 700; color: #0f172a;">+91 9876543210</p>
              </div>
              <div style="padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
                <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Date of Birth</p>
                <p style="font-size: 0.85rem; font-weight: 700; color: #0f172a;">12 Jan 2005</p>
              </div>
              <div style="padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
                <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Blood Group</p>
                <p style="font-size: 0.85rem; font-weight: 700; color: #0f172a;">B+</p>
              </div>
              <div style="padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
                <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Guardian Name</p>
                <p style="font-size: 0.85rem; font-weight: 700; color: #0f172a;">Sanjay Kumar</p>
              </div>
              <div style="padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
                <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Guardian Phone</p>
                <p style="font-size: 0.85rem; font-weight: 700; color: #0f172a;">+91 8765432109</p>
              </div>
              <div style="padding: 10px 0;">
                <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Address</p>
                <p style="font-size: 0.85rem; font-weight: 700; color: #0f172a;">Bhubaneswar, Odisha</p>
              </div>
            </div>

            <button onclick="PortalAuth.logout()" style="width: 100%; padding: 12px; border-radius: 12px; background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; font-weight: 800; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;">
              <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout of Student Portal
            </button>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- SCREEN 4: CAMPUS SERVICES (ALL IN ONE)     -->
        <!-- ========================================== -->
        <section id="screen-services" class="portal-screen">
          <div class="screen-header">
            <button class="screen-header-back" onclick="goBackScreen()"><i class="fa-solid fa-chevron-left"></i></button>
            <span class="screen-header-title">Campus Services</span>
            <span style="width: 20px;"></span>
          </div>

          <div style="padding: 12px 16px 0;">
            <div style="position: relative;">
              <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 12px; color: #94a3b8; font-size: 0.85rem;"></i>
              <input type="text" placeholder="Search services..." style="width: 100%; padding: 10px 14px 10px 38px; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 0.82rem; outline: none;">
            </div>
          </div>

          <!-- 10 Service Grid Tiles -->
          <div class="services-grid-2col">
            <a href="javascript:void(0)" onclick="navigateToScreen('screen-hostel')" class="service-tile">
              <div class="service-tile-icon" style="background: #eff6ff; color: #2563eb;"><i class="fa-solid fa-hotel"></i></div>
              <div>
                <div class="service-tile-title">Hostel</div>
                <div class="service-tile-desc">Room, Leave, Visitor, Complaint</div>
              </div>
            </a>

            <a href="javascript:void(0)" onclick="navigateToScreen('screen-attendance')" class="service-tile">
              <div class="service-tile-icon" style="background: #ecfdf5; color: #059669;"><i class="fa-solid fa-chart-pie"></i></div>
              <div>
                <div class="service-tile-title">Attendance</div>
                <div class="service-tile-desc">View Attendance & Reports</div>
              </div>
            </a>

            <a href="javascript:void(0)" onclick="navigateToScreen('screen-library')" class="service-tile">
              <div class="service-tile-icon" style="background: #faf5ff; color: #7c3aed;"><i class="fa-solid fa-book-bookmark"></i></div>
              <div>
                <div class="service-tile-title">Library</div>
                <div class="service-tile-desc">Search, Issue, Renewal</div>
              </div>
            </a>

            <a href="javascript:void(0)" onclick="navigateToScreen('screen-fees')" class="service-tile">
              <div class="service-tile-icon" style="background: #fef2f2; color: #dc2626;"><i class="fa-solid fa-receipt"></i></div>
              <div>
                <div class="service-tile-title">Accounts</div>
                <div class="service-tile-desc">Fees, Payment, Receipts</div>
              </div>
            </a>

            <a href="javascript:void(0)" onclick="navigateToScreen('screen-mess')" class="service-tile">
              <div class="service-tile-icon" style="background: #ccfbf1; color: #0d9488;"><i class="fa-solid fa-utensils"></i></div>
              <div>
                <div class="service-tile-title">Mess</div>
                <div class="service-tile-desc">Menu, Feedback, Complaints</div>
              </div>
            </a>

            <a href="javascript:void(0)" onclick="navigateToScreen('screen-hostel')" class="service-tile">
              <div class="service-tile-icon" style="background: #dbeafe; color: #0284c7;"><i class="fa-solid fa-id-badge"></i></div>
              <div>
                <div class="service-tile-title">Gate Pass</div>
                <div class="service-tile-desc">Apply & Track</div>
              </div>
            </a>

            <a href="/reporting/pages/submission.html" class="service-tile">
              <div class="service-tile-icon" style="background: #fdf2f8; color: #db2777;"><i class="fa-solid fa-file-shield"></i></div>
              <div>
                <div class="service-tile-title">Certificates</div>
                <div class="service-tile-desc">Bonafide, NOC, Documents</div>
              </div>
            </a>

            <a href="javascript:void(0)" onclick="navigateToScreen('screen-notices')" class="service-tile">
              <div class="service-tile-icon" style="background: #cffafe; color: #0891b2;"><i class="fa-solid fa-bullhorn"></i></div>
              <div>
                <div class="service-tile-title">Notices</div>
                <div class="service-tile-desc">Important Updates</div>
              </div>
            </a>

            <a href="javascript:void(0)" onclick="openReportModal()" class="service-tile">
