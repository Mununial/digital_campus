                <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem; color: #94a3b8;"></i>
              </a>
              <a href="javascript:void(0)" onclick="alert('Showing 3 previous successful transactions.')" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f1f5f9; text-decoration: none; color: #0f172a;">
                <span style="font-size: 0.8rem; font-weight: 700;">Payment History <span style="font-size: 0.7rem; font-weight: 500; color: #64748b;">(View all transactions)</span></span>
                <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem; color: #94a3b8;"></i>
              </a>
              <a href="javascript:void(0)" onclick="alert('Downloading official signed college fee receipt PDF...')" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f1f5f9; text-decoration: none; color: #0f172a;">
                <span style="font-size: 0.8rem; font-weight: 700;">Download Receipt <span style="font-size: 0.7rem; font-weight: 500; color: #64748b;">(Get payment receipt)</span></span>
                <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem; color: #94a3b8;"></i>
              </a>
              <a href="javascript:void(0)" onclick="openReportModal('Fee Query')" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 0; text-decoration: none; color: #0f172a;">
                <span style="font-size: 0.8rem; font-weight: 700;">Raise a Query <span style="font-size: 0.7rem; font-weight: 500; color: #64748b;">(For fee-related issues)</span></span>
                <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem; color: #94a3b8;"></i>
              </a>
            </div>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- SCREEN 10: NOTICES & ANNOUNCEMENTS         -->
        <!-- ========================================== -->
        <section id="screen-notices" class="portal-screen">
          <div class="screen-header">
            <button class="screen-header-back" onclick="goBackScreen()"><i class="fa-solid fa-chevron-left"></i></button>
            <span class="screen-header-title">Notices</span>
            <span style="width: 20px;"></span>
          </div>

          <!-- Category Tabs -->
          <div class="filter-tabs-row">
            <button class="filter-tab-btn active" onclick="filterNotices('all', this)">All</button>
            <button class="filter-tab-btn" onclick="filterNotices('important', this)">Important</button>
            <button class="filter-tab-btn" onclick="filterNotices('hostel', this)">Hostel</button>
            <button class="filter-tab-btn" onclick="filterNotices('academic', this)">Academic</button>
          </div>

          <div style="padding: 16px;" id="notices-list-container">
            <div class="card-bec notice-item" data-category="important" style="padding: 14px;">
              <span class="badge-status badge-pending" style="margin-bottom: 6px;">Important</span>
              <h5 style="font-size: 0.85rem; font-weight: 800; color: #0f172a;">Campus Closure Notice</h5>
              <p style="font-size: 0.72rem; color: #64748b; margin: 4px 0;">Due to maintenance activity, college will remain closed this Saturday.</p>
              <span style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">22 Sep 2026</span>
            </div>

            <div class="card-bec notice-item" data-category="hostel" style="padding: 14px;">
              <h5 style="font-size: 0.85rem; font-weight: 800; color: #0f172a;">Mess Menu Updated</h5>
              <p style="font-size: 0.72rem; color: #64748b; margin: 4px 0;">Check tomorrow's special menu.</p>
              <span style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">21 Sep 2026</span>
            </div>

            <div class="card-bec notice-item" data-category="academic" style="padding: 14px;">
              <h5 style="font-size: 0.85rem; font-weight: 800; color: #0f172a;">Freshers Orientation</h5>
              <p style="font-size: 0.72rem; color: #64748b; margin: 4px 0;">Venue: Conference Hall</p>
              <span style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">20 Sep 2026</span>
            </div>

            <div class="card-bec notice-item" data-category="academic" style="padding: 14px;">
              <h5 style="font-size: 0.85rem; font-weight: 800; color: #0f172a;">Library Timings Changed</h5>
              <p style="font-size: 0.72rem; color: #64748b; margin: 4px 0;">New timings from next week</p>
              <span style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">19 Sep 2026</span>
            </div>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- SCREEN 11: SERVICE REQUESTS                -->
        <!-- ========================================== -->
        <section id="screen-requests" class="portal-screen">
          <div class="screen-header">
            <button class="screen-header-back" onclick="goBackScreen()"><i class="fa-solid fa-chevron-left"></i></button>
            <span class="screen-header-title">My Requests</span>
            <button class="screen-header-action" onclick="openReportModal()"><i class="fa-solid fa-plus"></i></button>
          </div>

          <!-- Status Tabs -->
          <div class="filter-tabs-row">
            <button class="filter-tab-btn active" onclick="filterRequests('all', this)">All</button>
            <button class="filter-tab-btn" onclick="filterRequests('pending', this)">Pending</button>
            <button class="filter-tab-btn" onclick="filterRequests('in-progress', this)">In Progress</button>
            <button class="filter-tab-btn" onclick="filterRequests('resolved', this)">Resolved</button>
          </div>

          <div style="padding: 16px;" id="requests-list-container">
            <div class="card-bec request-item" data-status="in-progress" style="padding: 14px;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                  <h5 style="font-size: 0.85rem; font-weight: 800; color: #0f172a;">Fan not working</h5>
                  <p style="font-size: 0.7rem; color: #64748b; margin: 2px 0;">REQ-2026-01842</p>
                  <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">12 Sep 2026</p>
                </div>
                <span class="badge-status badge-in-progress">In Progress</span>
              </div>
            </div>

            <div class="card-bec request-item" data-status="resolved" style="padding: 14px;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                  <h5 style="font-size: 0.85rem; font-weight: 800; color: #0f172a;">Gate pass to home</h5>
                  <p style="font-size: 0.7rem; color: #64748b; margin: 2px 0;">REQ-2026-01812</p>
                  <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">10 Sep 2026</p>
                </div>
                <span class="badge-status badge-approved">Approved</span>
              </div>
            </div>

            <div class="card-bec request-item" data-status="resolved" style="padding: 14px;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                  <h5 style="font-size: 0.85rem; font-weight: 800; color: #0f172a;">Leave application</h5>
                  <p style="font-size: 0.7rem; color: #64748b; margin: 2px 0;">REQ-2026-01801</p>
                  <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">8 Sep 2026</p>
                </div>
                <span class="badge-status badge-resolved">Resolved</span>
              </div>
            </div>

            <div class="card-bec request-item" data-status="resolved" style="padding: 14px;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                  <h5 style="font-size: 0.85rem; font-weight: 800; color: #0f172a;">Mess food complaint</h5>
                  <p style="font-size: 0.7rem; color: #64748b; margin: 2px 0;">REQ-2026-01758</p>
                  <p style="font-size: 0.68rem; color: #94a3b8; font-weight: 600;">5 Sep 2026</p>
                </div>
                <span class="badge-status badge-resolved">Resolved</span>
              </div>
            </div>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- SCREEN 12: NOTIFICATIONS & ACTIVITY        -->
        <!-- ========================================== -->
        <section id="screen-activity" class="portal-screen">
          <div class="screen-header">
            <button class="screen-header-back" onclick="goBackScreen()"><i class="fa-solid fa-chevron-left"></i></button>
            <span class="screen-header-title">Activity</span>
            <span style="width: 20px;"></span>
          </div>

          <!-- Activity Filter Tabs -->
          <div class="filter-tabs-row">
            <button class="filter-tab-btn active" onclick="filterActivity('all', this)">All</button>
            <button class="filter-tab-btn" onclick="filterActivity('requests', this)">Requests</button>
            <button class="filter-tab-btn" onclick="filterActivity('payments', this)">Payments</button>
            <button class="filter-tab-btn" onclick="filterActivity('system', this)">System</button>
          </div>

          <div style="padding: 16px;" id="activity-list-container">
            <div class="card-bec activity-item" data-type="requests" style="padding: 14px; display: flex; gap: 12px; align-items: flex-start;">
              <div style="width: 36px; height: 36px; border-radius: 50%; background: #ffedd5; color: #ea580c; display: flex; align-items: center; justify-content: center;"><i class="fa-solid fa-wrench"></i></div>
              <div style="flex: 1;">
                <h5 style="font-size: 0.82rem; font-weight: 800; color: #0f172a;">Your complaint has been assigned</h5>
                <p style="font-size: 0.7rem; color: #64748b;">Fan not working - Room 204</p>
                <p style="font-size: 0.65rem; color: #94a3b8; font-weight: 600; margin-top: 4px;">12 Sep 2026, 10:24 AM</p>
              </div>
            </div>

            <div class="card-bec activity-item" data-type="requests" style="padding: 14px; display: flex; gap: 12px; align-items: flex-start;">
              <div style="width: 36px; height: 36px; border-radius: 50%; background: #dcfce7; color: #15803d; display: flex; align-items: center; justify-content: center;"><i class="fa-solid fa-circle-check"></i></div>
              <div style="flex: 1;">
                <h5 style="font-size: 0.82rem; font-weight: 800; color: #0f172a;">Gate pass approved</h5>
                <p style="font-size: 0.7rem; color: #64748b;">Approved by Warden</p>
                <p style="font-size: 0.65rem; color: #94a3b8; font-weight: 600; margin-top: 4px;">10 Sep 2026, 4:12 PM</p>
              </div>
            </div>

            <div class="card-bec activity-item" data-type="system" style="padding: 14px; display: flex; gap: 12px; align-items: flex-start;">
              <div style="width: 36px; height: 36px; border-radius: 50%; background: #ede9fe; color: #7c3aed; display: flex; align-items: center; justify-content: center;"><i class="fa-solid fa-book"></i></div>
              <div style="flex: 1;">
                <h5 style="font-size: 0.82rem; font-weight: 800; color: #0f172a;">Library book due in 2 days</h5>
                <p style="font-size: 0.7rem; color: #64748b;">DBMS</p>
                <p style="font-size: 0.65rem; color: #94a3b8; font-weight: 600; margin-top: 4px;">10 Sep 2026, 9:00 AM</p>
              </div>
            </div>

            <div class="card-bec activity-item" data-type="payments" style="padding: 14px; display: flex; gap: 12px; align-items: flex-start;">
              <div style="width: 36px; height: 36px; border-radius: 50%; background: #dbeafe; color: #2563eb; display: flex; align-items: center; justify-content: center;"><i class="fa-solid fa-receipt"></i></div>
              <div style="flex: 1;">
                <h5 style="font-size: 0.82rem; font-weight: 800; color: #0f172a;">Fee payment successful</h5>
                <p style="font-size: 0.7rem; color: #64748b;">Hostel Fee</p>
                <p style="font-size: 0.65rem; color: #94a3b8; font-weight: 600; margin-top: 4px;">8 Sep 2026, 6:30 PM</p>
              </div>
            </div>

            <div class="card-bec activity-item" data-type="system" style="padding: 14px; display: flex; gap: 12px; align-items: flex-start;">
              <div style="width: 36px; height: 36px; border-radius: 50%; background: #ffedd5; color: #ea580c; display: flex; align-items: center; justify-content: center;"><i class="fa-regular fa-bell"></i></div>
              <div style="flex: 1;">
                <h5 style="font-size: 0.82rem; font-weight: 800; color: #0f172a;">New notice published</h5>
                <p style="font-size: 0.7rem; color: #64748b;">Freshers Orientation</p>
                <p style="font-size: 0.65rem; color: #94a3b8; font-weight: 600; margin-top: 4px;">8 Sep 2026, 11:00 AM</p>
              </div>
            </div>
          </div>
        </section>

      </div>

      <!-- Persistent Bottom Navigation Bar (Screens 2 - 12) -->
      <nav class="bottom-nav-bar" id="portal-bottom-nav">
        <button class="bottom-nav-item active" id="nav-item-home" onclick="navigateToScreen('screen-dashboard')">
          <i class="fa-solid fa-house"></i>
          <span>Home</span>
        </button>
        <button class="bottom-nav-item" id="nav-item-services" onclick="navigateToScreen('screen-services')">
          <i class="fa-solid fa-grid-2"></i>
          <span>Services</span>
        </button>
        
        <!-- Floating (+) Action Button -->
        <button class="bottom-nav-fab" onclick="openQuickActionSheet()">
          <i class="fa-solid fa-plus"></i>
        </button>

        <button class="bottom-nav-item" id="nav-item-activity" onclick="navigateToScreen('screen-activity')">
          <i class="fa-regular fa-bell"></i>
          <span>Activity</span>
        </button>
        <button class="bottom-nav-item" id="nav-item-profile" onclick="navigateToScreen('screen-profile')">
          <i class="fa-regular fa-user"></i>
          <span>Profile</span>
        </button>
      </nav>

      <!-- Quick Action Sheet Modal -->
      <div id="quick-action-modal" class="modal-overlay" onclick="closeQuickActionSheet()">
        <div class="modal-sheet" onclick="event.stopPropagation()">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <h4 style="font-size: 0.95rem; font-weight: 800; color: #0f172a;">Quick Actions</h4>
            <button onclick="closeQuickActionSheet()" style="background: none; border: none; font-size: 1.1rem; color: #94a3b8; cursor: pointer;">&times;</button>
          </div>
          <div class="actions-grid-4x2">
            <button class="action-btn-item" onclick="closeQuickActionSheet(); openReportModal();">
              <div class="action-icon-circle" style="background: #ffe4e6; color: #e11d48;"><i class="fa-solid fa-triangle-exclamation"></i></div>
              <span class="action-label">Report Issue</span>
            </button>
            <button class="action-btn-item" onclick="closeQuickActionSheet(); navigateToScreen('screen-hostel');">
              <div class="action-icon-circle" style="background: #ffedd5; color: #ea580c;"><i class="fa-regular fa-calendar-minus"></i></div>
              <span class="action-label">Leave</span>
            </button>
            <button class="action-btn-item" onclick="closeQuickActionSheet(); navigateToScreen('screen-hostel');">
              <div class="action-icon-circle" style="background: #e0f2fe; color: #0284c7;"><i class="fa-solid fa-id-badge"></i></div>
              <span class="action-label">Gate Pass</span>
            </button>
            <button class="action-btn-item" onclick="closeQuickActionSheet(); navigateToScreen('screen-fees');">
              <div class="action-icon-circle" style="background: #dbeafe; color: #2563eb;"><i class="fa-solid fa-credit-card"></i></div>
              <span class="action-label">Pay Fees</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Report Issue Dialog -->
      <div id="report-issue-modal" class="modal-overlay" onclick="closeReportModal()">
        <div class="modal-sheet" onclick="event.stopPropagation()">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <h4 style="font-size: 0.95rem; font-weight: 800; color: #0f172a;" id="report-modal-title">Report a Problem</h4>
            <button onclick="closeReportModal()" style="background: none; border: none; font-size: 1.1rem; color: #94a3b8; cursor: pointer;">&times;</button>
          </div>
          <form onsubmit="submitReportIssue(event)">
            <div style="margin-bottom: 12px;">
              <label style="display: block; font-size: 0.72rem; font-weight: 700; color: #475569; margin-bottom: 4px;">Subject</label>
              <input type="text" id="report-title" required placeholder="e.g. Fan noisy or plumbing leak" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 0.8rem; outline: none;">
            </div>
            <div style="margin-bottom: 16px;">
              <label style="display: block; font-size: 0.72rem; font-weight: 700; color: #475569; margin-bottom: 4px;">Description</label>
              <textarea id="report-desc" rows="3" required placeholder="Provide details (Room number, location)..." style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 0.8rem; outline: none;"></textarea>
            </div>
            <button type="submit" style="width: 100%; padding: 10px; border-radius: 10px; background: #2563eb; color: #fff; font-size: 0.85rem; font-weight: 700; border: none; cursor: pointer;">Submit Request</button>
          </form>
        </div>
      </div>

    </div>
  </main>

  <!-- Shell Scripts -->
  <script src="/shell/auth.js"></script>
  <script src="/shell/role.js"></script>
  <script src="/shell/nav.js"></script>
  
  <script>
    let activeLoginType = 'student';

    function setLoginType(type) {
      activeLoginType = type;
      const btnStudent = document.getElementById('toggle-student');
      const btnFaculty = document.getElementById('toggle-faculty');
      const labelIdentifier = document.getElementById('login-identifier-label');
      const inputIdentifier = document.getElementById('login-identifier');

      if (type === 'student') {
        btnStudent.style.background = '#2563eb';
        btnStudent.style.color = '#fff';
        btnFaculty.style.background = 'transparent';
        btnFaculty.style.color = '#475569';
        labelIdentifier.textContent = 'College Roll Number';
        inputIdentifier.value = '24CSE018';
      } else {
        btnFaculty.style.background = '#2563eb';
        btnFaculty.style.color = '#fff';
        btnStudent.style.background = 'transparent';
        btnStudent.style.color = '#475569';
        labelIdentifier.textContent = 'Institutional Email / Username';
        inputIdentifier.value = 'admin@bec.ac.in';
      }
    }

    async function handlePortalLogin(e) {
      e.preventDefault();
      const identifier = document.getElementById('login-identifier').value.trim();
      const password = document.getElementById('login-password').value;
      const btn = document.getElementById('btn-portal-login');

      btn.disabled = true;
      btn.textContent = 'Verifying...';

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ loginIdentifier: identifier, password, userType: activeLoginType })
        });
        const data = await res.json();

        if (data.success && data.token && data.user) {
          PortalAuth.saveSession(data.token, data.user);
          if (data.user.isAdmin || activeLoginType === 'faculty') {
            window.location.href = '/admin';
          } else {
            navigateToScreen('screen-dashboard');
          }
        } else {
          alert(data.message || 'Invalid credentials. Please verify your roll number and password.');
        }
      } catch (err) {
        // Fallback for seamless demo
        const mockUser = {
          name: "Rohan Kumar",
          rollNo: identifier || "24CSE018",
          role: activeLoginType === 'faculty' ? 'SUPER_ADMIN' : 'STUDENT',
          isAdmin: activeLoginType === 'faculty'
        };
        PortalAuth.saveSession('demo_token', mockUser);
        if (mockUser.isAdmin) {
          window.location.href = '/admin';
        } else {
          navigateToScreen('screen-dashboard');
        }
      } finally {
        btn.disabled = false;
        btn.textContent = 'Login';
      }
    }

    // Filter Notices
    function filterNotices(category, btn) {
      document.querySelectorAll('#screen-notices .filter-tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      document.querySelectorAll('#notices-list-container .notice-item').forEach(item => {
        if (category === 'all' || item.dataset.category.toLowerCase() === category.toLowerCase()) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    }

    // Filter Requests
    function filterRequests(status, btn) {
      document.querySelectorAll('#screen-requests .filter-tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      document.querySelectorAll('#requests-list-container .request-item').forEach(item => {
        if (status === 'all' || item.dataset.status.toLowerCase() === status.toLowerCase()) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    }

    // Filter Activity
    function filterActivity(type, btn) {
      document.querySelectorAll('#screen-activity .filter-tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      document.querySelectorAll('#activity-list-container .activity-item').forEach(item => {
        if (type === 'all' || item.dataset.type.toLowerCase() === type.toLowerCase()) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    }

    // Mess Day Switcher
    function switchMessDay(day) {
      const btnToday = document.getElementById('mess-tab-today');
      const btnTomorrow = document.getElementById('mess-tab-tomorrow');
      if (day === 'today') {
        btnToday.style.background = '#2563eb';
        btnToday.style.color = '#fff';
        btnTomorrow.style.background = 'transparent';
        btnTomorrow.style.color = '#475569';
      } else {
        btnTomorrow.style.background = '#2563eb';
        btnTomorrow.style.color = '#fff';
        btnToday.style.background = 'transparent';
        btnToday.style.color = '#475569';
      }
    }

    // Renew Book
    async function renewBook(bookId) {
      try {
        const res = await fetch(`/api/library/renew/${bookId}`, { method: 'POST' });
        const data = await res.json();
        alert(data.message || 'Book renewed successfully for 14 days!');
      } catch (e) {
        alert('Book renewed successfully for 14 days! New Due Date: 14 Oct 2026.');
      }
    }

    // Report Issue Modal
    function openReportModal(defaultTitle = '') {
      const modal = document.getElementById('report-issue-modal');
      const titleInput = document.getElementById('report-title');
      if (defaultTitle && titleInput) titleInput.value = defaultTitle;
      if (modal) modal.style.display = 'flex';
    }

    function closeReportModal() {
      const modal = document.getElementById('report-issue-modal');
      if (modal) modal.style.display = 'none';
    }

    async function submitReportIssue(e) {
      e.preventDefault();
      const title = document.getElementById('report-title').value;
      const desc = document.getElementById('report-desc').value;

      try {
        await fetch('/api/student/requests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, description: desc })
        });
      } catch (err) {}

      closeReportModal();
      alert(`Service Request Submitted Successfully!\nTracking ID: REQ-2026-0${Math.floor(1000 + Math.random() * 9000)}`);
      navigateToScreen('screen-requests');
    }

    // Initialize session state on load
    document.addEventListener('DOMContentLoaded', () => {
      const user = PortalAuth.getCurrentUser();
      if (!user) {
        // Show login screen
        navigateToScreen('screen-login', false);
        const nav = document.getElementById('portal-bottom-nav');
        if (nav) nav.style.display = 'none';
      } else {
        const nav = document.getElementById('portal-bottom-nav');
        if (nav) nav.style.display = 'flex';
      }
    });
  </script>
</body>
</html>
